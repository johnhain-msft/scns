# SCNS Configuration
SCNS_PORT=3456
SCNS_LOG_LEVEL=info
SCNS_DATA_DIR=~/.scns
SCNS_MAX_CONCURRENT_SESSIONS=3
SCNS_YIELD_TO_USER=true
NODE_ENV=development

# Broker Configuration
BROKER_PORT=3456
BROKER_DB_PATH=~/.session-broker/data.db
BROKER_TOKEN=
BROKER_HEARTBEAT_INTERVAL_MS=10000
BROKER_HEARTBEAT_TIMEOUT_MS=20000
BROKER_ZOMBIE_GRACE_MS=300000
BROKER_AUTO_RESPAWN=true
BROKER_MAX_RESPAWN_RETRIES=3
BROKER_RESPAWN_BACKOFF_BASE_MS=5000
BROKER_AUTO_SCALE=false
BROKER_AUTO_SCALE_INTERVAL_MS=30000
HISTORY_RETENTION_DAYS=7

# Self-improvement target (#58/#63)
# The GitHub repo (owner/name) this install's self-issue ingestion reads from —
# a repository the authenticated gh account owns, typically your private home
# repo, NEVER the public upstream you cloned from. There is deliberately no
# default: when this is empty and the meta registry's global row declares no
# write target, self-issue ingestion refuses to run. Precedence:
# env > registry global row > refuse. See docs/plans/public-private-split.md.
SCNS_SELF_ISSUE_REPO=

# OTel Ingestion (SCNS side — reads Copilot CLI output)
OTEL_SCNS_ENABLED=true
OTEL_SCNS_FILE_PATH=
OTEL_SCNS_RETENTION_DAYS=7
OTEL_SCNS_MAX_SPANS_PER_TRACE=1000
OTEL_SCNS_POLL_INTERVAL_MS=1000

# Observation Layer
OBSERVE_TERMINAL_OPT_IN=false
OBSERVE_BROWSER_OPT_IN=false
OBSERVE_ACTIVE_APP_ENABLED=true
OBSERVE_ACTIVE_APP_INTERVAL_MS=30000
OBSERVE_FILE_ENABLED=true
OBSERVE_FILE_DIRS=
OBSERVE_GIT_ENABLED=true
OBSERVE_GIT_INTERVAL_MS=60000
OBSERVE_GIT_REPOS=
OBSERVE_BROWSER_INTERVAL_MS=30000
OBSERVE_TERMINAL_INTERVAL_MS=15000
OBSERVE_SESSION_HOOKS_ENABLED=true
OBSERVE_CONFIG_CHANGES_ENABLED=true
OBSERVE_EXCLUDE_APPS=
OBSERVE_EXCLUDE_PATHS=
OBSERVE_EXCLUDE_URLS=
OBSERVE_SANITIZE_SECRETS=true
OBSERVE_CHRONICLE_ENABLED=false
OBSERVE_CHRONICLE_PATH=~/.copilot/chronicle
OBSERVE_CHRONICLE_INTERVAL_MS=30000
OBSERVE_CHRONICLE_MAX_ENTRIES=1000
OBSERVE_SESSION_STORE_ENABLED=false
OBSERVE_SESSION_STORE_PATH=
OBSERVE_SESSION_STORE_INTERVAL_MS=60000
OBSERVE_SESSION_STORE_MAX_SESSIONS=100

# Dashboard (set in dashboard/.env.local)
# NEXT_PUBLIC_BROKER_URL=http://localhost:3456
# NEXT_PUBLIC_BROKER_TOKEN=
