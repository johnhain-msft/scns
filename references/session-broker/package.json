{
  "name": "@everything-copilot/session-broker",
  "version": "0.1.0",
  "description": "Platform-agnostic AI agent orchestration broker with MCP, REST, and SSE interfaces",
  "license": "MIT",
  "type": "module",
  "bin": {
    "session-broker": "./dist/session-broker/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/session-broker/index.js",
      "types": "./dist/session-broker/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/session-broker/storage/schema.sql dist/session-broker/storage/schema.sql",
    "dev": "tsx src/session-broker/index.ts",
    "start": "node dist/session-broker/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "validate": "bash tests/validate.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "better-sqlite3": "^12.6.0",
    "express": "^5.0.1",
    "express-rate-limit": "^8.3.2",
    "fastembed": "^2.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
